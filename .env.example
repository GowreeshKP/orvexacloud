# ─────────────────────────────────────────────────────────────────────────────
# Orvexa Tech — Environment Variables Reference
# Copy this file to .env, fill in real values, and set them in your deployment dashboard.
# NEVER commit real credentials — .env* is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Orvexa Cloud Master Database (Supabase / PostgreSQL) ──────────────────
# Project: D2C-Multi-tenant-webapp (West EU Ireland / eu-west-1)
# Project URL (Frontend & Backend):
VITE_SUPABASE_URL=https://xkiutrwppsnvvogmxtby.supabase.co
SUPABASE_URL=https://xkiutrwppsnvvogmxtby.supabase.co

# Supabase Public Anon Key (safe for frontend queries):
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Secret Key (Backend Super Admin operations only):
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Direct PostgreSQL Connection String (from Supabase Database settings):
SUPABASE_DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# ── 2. Tier-2 Store Owner Isolated Databases (BYODB / MongoDB / Postgres) ────
# Base URI for tenant-isolated databases — tenant slug is dynamically appended at runtime:
MONGODB_MASTER_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/orvexatech_master?retryWrites=true&w=majority
MONGODB_TENANT_BASE_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/orvexa_tenant_

# ── 3. JWT Authentication ────────────────────────────────────────────────────
# Two DIFFERENT random values, each ≥ 32 chars (openssl rand -hex 32). The server refuses to
# start in production if either is missing, short, or they are equal.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_for_refresh_tokens
# Access-token lifetime (refresh tokens last 30 days):
ACCESS_TOKEN_TTL=1h

# ── 4. CORS & Routing ────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (exact match; "*" is ignored in production):
CORS_ORIGIN=http://localhost:8443,https://your-app.vercel.app
# Trust *.vercel.app preview deployments too (anyone can create one, so keep off in production):
CORS_ALLOW_VERCEL_PREVIEWS=false
# Reverse-proxy hops in front of the API (rate limits key on the client IP). Defaults to 1 on Render and Vercel.
TRUST_PROXY=1
# Set by the deploy pipeline so /api/health reports the running git SHA (Render also sets RENDER_GIT_COMMIT).
GIT_SHA=

# ── 5. One-Time Super Admin Bootstrap Key ────────────────────────────────────
# ≥ 16 random chars. Only works while no admin exists. Store owner passwords are set by a
# signed-in super admin (POST /api/auth/seller/set-password); there is no shared setup key.
ADMIN_BOOTSTRAP_KEY=replace_with_strong_random_key

# ── 5b. Optional features ────────────────────────────────────────────────────
# Let merchants connect their own MongoDB (mongodb+srv only). Off by default: the server
# connects to whatever host the merchant enters.
ALLOW_CUSTOM_DATABASES=false
# Frontend offline demo mode (local credential fallbacks). Never enable for real merchants.
VITE_DEMO_MODE=false

# ── 6. Marketing Site Signup Connector (orvexacloud.in → POST /api/public/signups) ──
# Shared HMAC secret(s) from your secret manager. Comma-separate two values to rotate without downtime.
# Give the connector: SUPER_ADMIN_SIGNUP_URL=https://admin.orvexacloud.in/api/public/signups
#                     SUPER_ADMIN_SLUG_CHECK_URL=https://admin.orvexacloud.in/api/public/slug-available
SIGNUP_SIGNING_SECRETS=replace_with_shared_signing_secret
PLATFORM_ROOT_DOMAIN=orvexacloud.in
# Base URL used in owner set-password links sent on approval:
PUBLIC_APP_URL=https://admin.orvexacloud.in

# ── 7. Decision Emails (Resend; see the handoff's RESEND_SETUP.md) ──
# Key: Sending access, restricted to mail.orvexacloud.in. Set it as a host secret, never in git.
RESEND_API_KEY=
# Must be on the domain verified in Resend, or Resend refuses every email (HTTP 403).
MAIL_FROM="Orvexa Cloud <hello@mail.orvexacloud.in>"
MAIL_REPLY_TO=support@orvexacloud.in
# Optional team inbox told about each new website signup (no owner contact details are included).
SIGNUP_NOTIFY_EMAIL=

# ── 7b. Razorpay subscriptions (India). Prices exclude 18% GST; the server adds GST. ──
# Without these, checkout returns 503 and trial/grace transitions still run from the dates.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── 8. Server Port (Local Dev) ───────────────────────────────────────────────
PORT=5000
