{
  "name": "d2c-multi-tenant-webapp",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "RENDER_API_ORIGIN": "https://orvexa-api-nskw.onrender.com"
  }
}
