{
  "name": "d2c-multi-tenant-webapp",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker first for API proxy + legacy /t/{slug} redirects to production portals.
    "run_worker_first": ["/t", "/t/*", "/api", "/api/*"]
  },
  // Platform control plane only. Marketing + /{slug} storefronts stay on orvexacloud.in.
  "routes": [
    { "pattern": "app.orvexacloud.in/*", "zone_name": "orvexacloud.in" }
  ],
  "vars": {
    "RENDER_API_ORIGIN": "https://orvexa-api-nskw.onrender.com"
  }
}
