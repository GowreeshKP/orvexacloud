{
  "name": "d2c-multi-tenant-webapp",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker must run first so /t/{slug} can 302 to https://{slug}.orvexacloud.in
    "run_worker_first": ["/t", "/t/*", "/api", "/api/*"]
  },
  // Tenant stores: {slug}.orvexacloud.in → this Worker (apex marketing stays on its own Worker).
  // Requires DNS: CNAME * → the same target as app.orvexacloud.in (Cloudflare proxy on).
  "routes": [
    { "pattern": "app.orvexacloud.in/*", "zone_name": "orvexacloud.in" },
    { "pattern": "*.orvexacloud.in/*", "zone_name": "orvexacloud.in" }
  ],
  "vars": {
    "RENDER_API_ORIGIN": "https://orvexa-api-nskw.onrender.com"
  }
}
