{
  "name": "d2c-multi-tenant-webapp",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  // Keep workers.dev for preview while app.orvexacloud.in DNS/zone lives on another CF account.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker first for API proxy + legacy /t/{slug} redirects to production portals.
    "run_worker_first": ["/t", "/t/*", "/api", "/api/*"]
  },
  // Route attach needs the CF account that owns zone orvexacloud.in.
  // Until then, ship via Pages (orvexatech-multi-store) + workers.dev.
  // "routes": [
  //   { "pattern": "app.orvexacloud.in/*", "zone_name": "orvexacloud.in" }
  // ],
  "vars": {
    "RENDER_API_ORIGIN": "https://orvexa-api-nskw.onrender.com"
  }
}
