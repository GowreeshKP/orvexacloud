{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@orvexa/theme": ["./packages/theme/src"],
      "@orvexa/storefront-ui": ["./packages/storefront-ui/src"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "packages", "vite.config.ts"],
  "exclude": ["packages/**/*.test.ts", "packages/**/*.test.tsx", "node_modules", "dist", "server"]
}
